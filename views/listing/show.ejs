<% layout("layouts/boilerplate") %>
  <div class="row justify-content-center">
    <div class=" col-md-4">

      <div class="showpara">
        <h1>Your Selected Listing is: </h1>
       
        </p>
      </div>


      <div class="show-card card-container">

        <div class="card">
          <img src="<%= listing.image.url %>" alt="listing">

          <div class="card-body">
            <h3 class="card-title"><b>
                <%= listing.title %>
              </b></h3>

            <p class="card-desc">
              Owned By:<b>
                <%= listing.owner.username %>
              </b>
            </p>
            <p class="card-desc">
              <%= listing.description %>
            </p>
            <p class="card-price">₹ <%= listing.price.toLocaleString("en-IN") %>
            </p>
            <p class="card-location">
              <%= listing.location %>
            </p>
            <p class="card-country">
              <%= listing.country %>
            </p>

            <% if(currUser && listing.owner.equals(currUser._id)) { %>
              <div class="actions">
                <a href="/listings/<%= listing._id %>/edit" class="btn-edit">Edit</a>


                <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" style="display: inline;">
                  <button type="submit" class="btn-delete">Delete</button>
                </form>

              </div>
              <% } %>


                <a href="/listings" class="btn-back">← All Listings</a>
          </div>
        </div>


      </div> <!---col-->
    </div> <!---row-->
    <% if(currUser){ %>
      <div class="reviewpara">
        <h1>Leave a Review!!</h1>
      </div>

      <div class=" mb-5 formcard">
        <form class="form-container needs-validation" action="/listings/<%= listing._id %>/reviews" method="post"
          novalidate>


          <div class="formcontrol">
            <label for="comment">Comment:</label>
            <textarea cols="10" rows="5" name="review[comment]" id="comment"
              placeholder="Describe what makes this place special..."></textarea>
            <!-- <div class="valid-feedback">
          Looks good! ✅
        </div> -->
          </div>




          <div class="formcontrol">
            <label for="rating">Rating:</label>
            <div class="star-rating">
              <input type="radio" name="review[rating]" id="star5" value="5">
              <label for="star5">★</label>

              <input type="radio" name="review[rating]" id="star4" value="4">
              <label for="star4">★</label>

              <input type="radio" name="review[rating]" id="star3" value="3">
              <label for="star3">★</label>

              <input type="radio" name="review[rating]" id="star2" value="2">
              <label for="star2">★</label>

              <input type="radio" name="review[rating]" id="star1" value="1">
              <label for="star1">★</label>
            </div>
          </div>


          <button class="btn btn-primary mt-3">Submit</button>


        </form>
      </div>
      <% } %>

        <div class="reviewsection">
          <h2>All Reviews</h2>

          <% if (listing.reviews.length===0) { %>
            <p>No reviews yet 😔</p>
            <% }else { %>
              <div class="cardbody">



                <% for(let review of listing.reviews) { %>
                  <div class="reviewcard">
                    <h5 class="card-title">
                      @<%= review.author.username %>
                    </h5>
                    <p class="card-text">
                      <%= review.comment %>
                    </p>
                    <% for(let i=1; i<=5; i++) { %>
                      <% if(i <=review.rating) { %>
                        <span class="star-filled">★</span>
                        <% } else { %>
                          <span class="star-empty">☆</span>
                          <% } %>
                            <% } %>

                            <% if(currUser && review.author.equals(currUser._id)) { %>

                              <div class="actions2">
                                <a href="/listings/<%= listing._id %>/reviews/<%= review._id %>/edit"
                                  class="btn-edit">Edit</a>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                  method="post">
                                  <button type="submit" class="btn-delete">Delete</button>
                                </form>
                              </div>
                              <% } %>
                  </div>


                  <% } %>

              </div>
              <% } %>
                

               
               
        </div>

        <div id="map"
     data-latitude="<%= listing.latitude %>"
     data-longitude="<%= listing.longitude %>"
      data-title="<%= listing.title %>"
     data-location="<%= listing.location %>"
     data-price="<%= listing.price %>"
     data-id="<%= listing._id %>">
</div>

                  

       